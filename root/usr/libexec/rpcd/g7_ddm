#!/bin/sh
# TP-Link XZ000-G7 (OpenWrt galachip firmware) DDM & GPON diagnostics rpcd backend.
# Structure modified from luci-app-hsgq-ddm / luci-app-vsol-ddm (Apache-2.0). See NOTICE.
#
# The G7 publishes its optics and GPON state read-only to unauthenticated callers
# (ubus "xpon.public status" and "omci.agent status" over its /ubus JSON-RPC
# endpoint), so only its address is required. An optional username and password
# (the G7's own LuCI login) add system information, the OMCI MIB and restart.
#
# A background poller (run_daemon) is the only thing that polls the G7. The
# dashboard reads what it last stored, so opening the page never adds load on
# the ONU, whose web server serves at most three requests at a time.

UCI_CONFIG="g7_ddm"
CACHE_FILE="${CACHE_FILE:-/tmp/g7_ddm_cache.json}"
HISTORY_FILE="${HISTORY_FILE:-/tmp/g7_ddm_history.json}"
SID_FILE="${SID_FILE:-/tmp/g7_ddm.sid}"
PARSER="${PARSER:-/usr/share/g7_ddm/parse.awk}"
MAX_HISTORY_ENTRIES=1440
PUBLIC_SID="00000000000000000000000000000000"

# Seconds between polls, and the age after which a reading counts as lost: one
# missed poll is tolerated, a dead ONU surfaces within about a minute.
POLL_EVERY="${POLL_EVERY:-30}"
MAX_STALE="${MAX_STALE:-75}"

# Files here (cache, session ID) are readable by root only.
umask 077

get_config() {
	ENABLED="1"
	HOST=""
	PORT="80"
	TIMEOUT="8"
	OPTICAL_CLASS="bplus"
	USER=""
	PASS=""

	if command -v uci >/dev/null 2>&1; then
		v=$(uci -q get ${UCI_CONFIG}.main.enabled);       [ -n "$v" ] && ENABLED="$v"
		v=$(uci -q get ${UCI_CONFIG}.main.host);          [ -n "$v" ] && HOST="$v"
		v=$(uci -q get ${UCI_CONFIG}.main.port);          [ -n "$v" ] && PORT="$v"
		v=$(uci -q get ${UCI_CONFIG}.main.timeout);       [ -n "$v" ] && TIMEOUT="$v"
		v=$(uci -q get ${UCI_CONFIG}.main.optical_class); [ -n "$v" ] && OPTICAL_CLASS="$v"
		v=$(uci -q get ${UCI_CONFIG}.main.username);      [ -n "$v" ] && USER="$v"
		# an empty password is valid: it is the G7's default
		PASS=$(uci -q get ${UCI_CONFIG}.main.password)
	fi

	case "$OPTICAL_CLASS" in bplus|cplus|epon_px20) ;; *) OPTICAL_CLASS="bplus" ;; esac
	case "$PORT" in ''|*[!0-9]*) PORT=80 ;; esac
	case "$TIMEOUT" in ''|*[!0-9]*) TIMEOUT=8 ;; esac
	[ "$TIMEOUT" -lt 3 ] && TIMEOUT=3
	[ "$TIMEOUT" -gt 30 ] && TIMEOUT=30
}

# The address has no default on purpose: probing a guessed address would reach
# some other device on someone else's network.
is_configured() {
	[ -n "$HOST" ]
}

has_login() {
	[ -n "$USER" ]
}

unconfigured_json() {
	printf '{"success": false, "configured": false, "connected": false, "host": "", "error": "Not configured. Set the G7 address under Settings."}\n'
}

# The text of a JSON string for a shell value: backslash, quote, tab, CR, LF escaped.
json_str() {
	printf '%s' "$1" | awk 'BEGIN { RS = "\001" } {
		gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); gsub(/\n/, "\\n")
		printf "%s", $0 }'
}

http_post() {
	# http_post <url> <body>
	if command -v curl >/dev/null 2>&1; then
		curl -s -m "$TIMEOUT" -X POST -H 'Content-Type: application/json' --data "$2" "$1"
	else
		uclient-fetch -q -T "$TIMEOUT" -O - --post-data="$2" "$1" 2>/dev/null
	fi
}

g7_url() {
	if [ "$PORT" = 80 ]; then echo "http://$HOST/ubus"; else echo "http://$HOST:$PORT/ubus"; fi
}

# One ubus call as a JSON-RPC request: rpc <id> <session> <object> <method> [json args]
rpc() {
	_args="$5"
	[ -n "$_args" ] || _args="{}"
	printf '{"jsonrpc":"2.0","id":%s,"method":"call","params":["%s","%s","%s",%s]}' "$1" "$2" "$3" "$4" "$_args"
}

# Log in to the G7 (an rpcd session, like its own LuCI) and print the session ID.
# A saved session is reused unless "login 1" asks for a fresh one.
login() {
	if [ "$1" != 1 ] && [ -s "$SID_FILE" ]; then
		cat "$SID_FILE"
		return 0
	fi
	_args="{\"username\":\"$(json_str "$USER")\",\"password\":\"$(json_str "$PASS")\",\"timeout\":900}"
	_r=$(http_post "$(g7_url)" "$(rpc 1 "$PUBLIC_SID" session login "$_args")") || return 1
	_sid=$(printf '%s' "$_r" | sed -n 's/.*"ubus_rpc_session"[ ]*:[ ]*"\([0-9a-f]*\)".*/\1/p')
	if [ "${#_sid}" != 32 ]; then
		rm -f "$SID_FILE"
		return 1
	fi
	printf '%s' "$_sid" > "$SID_FILE"
	echo "$_sid"
}

# True for a reply that rejects the session (expired or never valid)
session_rejected() {
	case "$1" in *'"code":-32002'*|*'Access denied'*) return 0 ;; esac
	return 1
}

# The status request: the two public calls, plus system info and board with a session.
status_request() {
	if [ "$1" = "$PUBLIC_SID" ]; then
		printf '[%s,%s]' "$(rpc 1 "$1" xpon.public status)" "$(rpc 2 "$1" omci.agent status)"
	else
		printf '[%s,%s,%s,%s]' "$(rpc 1 "$1" xpon.public status)" "$(rpc 2 "$1" omci.agent status)" \
			"$(rpc 3 "$1" system info)" "$(rpc 4 "$1" system board)"
	fi
}

# Query the G7 and print the dashboard JSON. Sets AUTH to what the login did.
do_query() {
	AUTH="public"
	_sid="$PUBLIC_SID"
	if has_login; then
		if _sid=$(login); then
			AUTH="logged in as $USER"
		else
			_sid="$PUBLIC_SID"
			AUTH="login failed for $USER"
		fi
	fi
	_raw=$(http_post "$(g7_url)" "$(status_request "$_sid")") || return 1
	if [ "$_sid" != "$PUBLIC_SID" ] && session_rejected "$_raw"; then
		if _sid=$(login 1); then
			_raw=$(http_post "$(g7_url)" "$(status_request "$_sid")") || return 1
		else
			AUTH="login failed for $USER"
			_raw=$(http_post "$(g7_url)" "$(status_request "$PUBLIC_SID")") || return 1
		fi
	fi
	[ -n "$_raw" ] || return 1
	printf '%s\n' "$_raw" | awk -v host="$HOST" -v ts="$(date +%s)" -v req_class="$OPTICAL_CLASS" \
		-v auth="$AUTH" -f "$PARSER"
}

# One authenticated call; prints the raw reply. Logs in again once when the
# saved session was rejected. auth_call <object> <method> [json args]
auth_call() {
	_sid=$(login) || return 1
	_r=$(http_post "$(g7_url)" "$(rpc 1 "$_sid" "$1" "$2" "$3")") || return 1
	if session_rejected "$_r"; then
		_sid=$(login 1) || return 1
		_r=$(http_post "$(g7_url)" "$(rpc 1 "$_sid" "$1" "$2" "$3")") || return 1
	fi
	printf '%s' "$_r"
}

record_history_sample() {
	[ -n "$1" ] || return 0
	_now=$(date +%s)
	if [ -f "$HISTORY_FILE" ]; then
		_last_ts=$(tail -n 1 "$HISTORY_FILE" 2>/dev/null | sed -n 's/^\[\([0-9]*\),.*/\1/p')
		[ -n "$_last_ts" ] && [ $(( _now - _last_ts )) -lt 55 ] && return 0
	fi

	printf '%s\n' "$1" | awk -v now="$_now" -v hist="$HISTORY_FILE" '
	function grab(k,    s) {
		if (match($0, "\"" k "\"[ \t]*:[ \t]*-?[0-9.]+")) { s = substr($0, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", s); return s }
		return ""
	}
	BEGIN { rx = "null"; tx = "null"; temp = "null"; bias = "null"; ok = 0 }
	/"success"[ \t]*:[ \t]*true/ { ok = 1 }
	{ v = grab("rx_power_dbm"); if (v != "") rx = v
	  v = grab("tx_power_dbm"); if (v != "") tx = v
	  v = grab("temperature_c"); if (v != "") temp = v
	  v = grab("bias_current_ma"); if (v != "") bias = v }
	END { if (ok) print "[" now "," rx "," tx "," temp "," bias "]" >> hist }'

	_lines=$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)
	if [ "$_lines" -gt "$MAX_HISTORY_ENTRIES" ]; then
		sed -i "1,$(( _lines - MAX_HISTORY_ENTRIES ))d" "$HISTORY_FILE" 2>/dev/null
	fi
}

get_history() {
	printf '{"success": true, "timestamp": %s, "history": [' "$(date +%s)"
	[ -f "$HISTORY_FILE" ] && awk 'NR>1{printf ","} {printf "%s", $0}' "$HISTORY_FILE"
	printf ']}\n'
}

# Write a successful result atomically, so a reader never sees half a file.
store_result() {
	case "$1" in
		*'"success": true'*)
			printf '%s' "$1" > "${CACHE_FILE}.$$" 2>/dev/null && mv "${CACHE_FILE}.$$" "$CACHE_FILE" 2>/dev/null
			rm -f "${CACHE_FILE}.$$" 2>/dev/null
			record_history_sample "$1"
			return 0
			;;
	esac
	return 1
}

poll_device() {
	get_config
	is_configured || return 0
	[ "$ENABLED" = "1" ] || return 0
	store_result "$(do_query)"
}

run_daemon() {
	while true; do
		poll_device >/dev/null 2>&1
		sleep "$POLL_EVERY"
	done
}

cache_age() {
	[ -f "$CACHE_FILE" ] || return 1
	_mt=$(date -r "$CACHE_FILE" +%s 2>/dev/null) || return 1
	echo $(( $(date +%s) - _mt ))
}

# Answer the dashboard from the poller's cache only; never contacts the G7.
read_status() {
	get_config
	is_configured || { unconfigured_json; return; }

	if [ "$ENABLED" != "1" ]; then
		printf '{"success": false, "connected": false, "host": "%s", "error": "Monitoring has been disabled in configuration"}\n' "$HOST"
		return
	fi

	_age=$(cache_age)
	if [ -n "$_age" ] && [ "$_age" -le "$MAX_STALE" ]; then
		cat "$CACHE_FILE"
	elif [ -n "$_age" ]; then
		printf '{"success": false, "connected": false, "host": "%s", "error": "No answer from the G7 at %s for %s s (background poller)"}\n' "$HOST" "$HOST" "$_age"
	else
		printf '{"success": false, "connected": false, "host": "%s", "error": "Waiting for the first reading from the background poller (every %s s)"}\n' "$HOST" "$POLL_EVERY"
	fi
}

test_connection() {
	get_config
	is_configured || { unconfigured_json; return; }

	# do_query runs in a subshell here, so the login result comes from its output
	_out=$(do_query)
	_auth=$(printf '%s' "$_out" | sed -n 's/^[ ]*"auth": "\(.*\)",$/\1/p')
	case "$_out" in
		*'"success": true'*)
			case "$_auth" in
				"login failed"*)
					printf '{"success": false, "connected": true, "host": "%s", "error": "The G7 answers, but the login failed: check the username and password (the public status still works)"}\n' "$HOST" ;;
				"logged in"*)
					printf '{"success": true, "connected": true, "host": "%s", "message": "The G7 answered and the login works"}\n' "$HOST" ;;
				*)
					printf '{"success": true, "connected": true, "host": "%s", "message": "The G7 answered with its optical and GPON status"}\n' "$HOST" ;;
			esac ;;
		*)
			printf '{"success": false, "connected": false, "host": "%s", "error": "No status from http://%s/ubus (is it a G7 running the galachip OpenWrt firmware?)"}\n' "$HOST" "$HOST" ;;
	esac
}

# The OMCI MIB (omci.agent mib_list) needs the login. The objects are passed on
# as the G7 reports them; the dashboard decodes their attributes (g7_ddm/omci.js).
fetch_omci() {
	get_config
	is_configured || { unconfigured_json; return; }
	if ! has_login; then
		printf '{"success": false, "connected": true, "host": "%s", "error": "The OMCI tables need the G7 login: add its username and password under Settings."}\n' "$HOST"
		return
	fi
	if ! _r=$(auth_call omci.agent mib_list); then
		printf '{"success": false, "connected": false, "host": "%s", "error": "Could not log in to the G7 at %s: check the username and password."}\n' "$HOST" "$HOST"
		return
	fi
	case "$_r" in
		*'"result":[0,{"objects":'*)
			# {"jsonrpc":..,"result":[0,{"objects":[...]}]} -> {"success": true, ..., "objects":[...]}
			printf '%s\n' "$_r" | sed -e 's/^.*"result":\[0,{"objects":/{"success": true, "connected": true, "host": "'"$HOST"'", "objects":/' \
				-e 's/}\][ ]*}[ ]*$/}/'
			;;
		*)
			printf '{"success": false, "connected": true, "host": "%s", "error": "The G7 did not return its OMCI MIB (is the login an administrator?)"}\n' "$HOST" ;;
	esac
}

do_restart() {
	get_config
	is_configured || { unconfigured_json; return; }
	if ! has_login; then
		printf '{"success": false, "host": "%s", "error": "Restarting needs the G7 login: add its username and password under Settings, or use System -> Reboot in its web interface (http://%s)."}\n' "$HOST" "$HOST"
		return
	fi
	case "$(auth_call system reboot)" in
		*'"result":[0'*)
			rm -f "$SID_FILE" "$CACHE_FILE"
			printf '{"success": true, "host": "%s", "message": "Restart command sent to the G7. It will be unreachable for about a minute."}\n' "$HOST" ;;
		*)
			printf '{"success": false, "host": "%s", "error": "The G7 did not accept the restart: check the username and password."}\n' "$HOST" ;;
	esac
}

case "$1" in
	list)
		echo '{ "get_status": {}, "get_info": {}, "get_history": {}, "test_connection": {}, "get_omci": {}, "restart": {} }'
		;;
	call)
		case "$2" in
			get_status|get_info) read_status ;;
			get_history) get_history ;;
			get_omci) fetch_omci ;;
			restart) do_restart ;;
			test_connection) test_connection ;;
			*) echo '{"error": "Unknown method"}' ;;
		esac
		;;
	daemon)
		run_daemon
		;;
	poll)
		poll_device
		;;
	*)
		echo '{"error": "Invalid action"}'
		;;
esac
