#!/bin/sh /etc/rc.common
# Modified from luci-app-hsgq-ddm / luci-app-vsol-ddm (Apache-2.0) for the
# TP-Link XZ000-G7 (galachip OpenWrt). See NOTICE.

USE_PROCD=1
START=95
STOP=10

PROG="/usr/libexec/rpcd/g7_ddm"

start_service() {
	local enabled
	# a changed login must not reuse the session of the previous one
	rm -f /tmp/g7_ddm.sid
	config_load g7_ddm
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" "daemon"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "g7_ddm"
}
